{
  "name": "island-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:test": "esbuild scripts/genTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/genTest.mjs --log-level=warning && node node_modules/.cache/genTest.mjs",
    "wave:test": "esbuild scripts/waveTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/waveTest.mjs --log-level=warning --external:phaser && node node_modules/.cache/waveTest.mjs",
    "conditions:test": "esbuild scripts/conditionsTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/conditionsTest.mjs --log-level=warning && node node_modules/.cache/conditionsTest.mjs",
    "pool:test": "esbuild scripts/islandPoolTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/islandPoolTest.mjs --log-level=warning && node node_modules/.cache/islandPoolTest.mjs",
    "menu:seed": "esbuild scripts/menuSeed.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/menuSeed.mjs --log-level=warning && node node_modules/.cache/menuSeed.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.90.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
